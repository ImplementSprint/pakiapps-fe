# PakiPark — NestJS BFF Environment Variables
# Copy this file to .env and fill in your values.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT — public key from shared-service (RS256)
# Use the full PEM string with escaped newlines, or load from a file.
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Shared-service connection
SHARED_SERVICE_URL=http://shared-service:3000
INTERNAL_SERVICE_KEY=your-internal-service-secret

# Server
PORT=3002

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
